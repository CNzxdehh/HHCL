<UserControl x:Class="HHCL.Views.ModDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部只放返回。安装目录放到「打开安装目录」按钮的悬停提示里：
                 长路径放顶栏会被挤成两行（试过 Grid/DockPanel/固定宽度都不受控），不如收起来 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button x:Name="BackBtn" Content="← 返回" Style="{StaticResource GhostButton}" Height="32" Width="96"
                        HorizontalAlignment="Left" Click="Back_Click" />
                <TextBlock x:Name="TargetText" Style="{StaticResource Label}" Margin="14,0,0,0"
                           VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- 项目信息 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,13" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="58" CornerRadius="12" Background="{DynamicResource AccentIconBrush}" VerticalAlignment="Top">
                        <Image Source="{Binding IconUrl, ElementName=IconImg}" Stretch="UniformToFill" Width="58" Height="58" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock x:Name="TitleText" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="22"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubText" Text="" Style="{StaticResource Label}" Margin="0,6,0,0" />
                        <TextBlock x:Name="DescText" Text="" Style="{StaticResource Body}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" LineHeight="21" MaxHeight="120" />
                    </StackPanel>
                    <Image x:Name="IconImg" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 版本选择 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,13" Margin="0,12,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VersionHeader" Text="版本" Style="{StaticResource H2}" FontSize="15" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="VersionCountText" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Button x:Name="CollapseAllBtn" Content="全部收起" Style="{StaticResource GhostButton}"
                                    Height="26" Padding="10,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Click="CollapseAll_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="StateText" Text="" Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <!-- 安装区放顶部：列表几百条，放下面要滚很久才看得到按钮 -->
                    <Border Background="{DynamicResource AccentPanelBrush}" CornerRadius="7" Padding="11,8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PickText" Text="" Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="InstallBtn" Content="下载并安装" Style="{StaticResource AccentButton}"
                                        Height="34" Width="146" FontSize="13" Click="Install_Click" IsEnabled="False" />
                                <Button x:Name="OpenDirBtn" Content="打开安装目录" Style="{StaticResource GhostButton}"
                                        Height="34" FontSize="13" Margin="8,0,0,0" Click="OpenDir_Click" />
                                <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostButton}" Height="34"
                                        Width="76" FontSize="13" Margin="8,0,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                            </StackPanel>
                            <ProgressBar x:Name="Bar" Style="{StaticResource FluentProgress}" Height="5"
                                         Margin="0,10,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ProgText" Text="" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="VersionList" Style="{StaticResource FluentListBox}" Margin="0,10,0,0"
                             MaxHeight="560" HorizontalContentAlignment="Stretch"
                             SelectionChanged="VersionList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Margin" Value="2,5" />
                                            <Style.Triggers>
                                                <!-- 组头：游戏版本标题（26.3 / 1.21.4 …），点不动、选不中 -->
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Margin" Value="2,6,2,2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- 组头：整行可点击，折叠/展开这一组。
                                         样式改成"左侧竖条 + 版本号 + 计数"，比一条灰底蓝字好看 -->
                                    <Button Click="Header_Click">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="6,5" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{DynamicResource CardHoverBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 左侧竖条 -->
                                            <Border Grid.Column="0" Width="3" Height="13" CornerRadius="2"
                                                    Background="{DynamicResource AccentBrush}" Margin="0,0,7,0"
                                                    VerticalAlignment="Center" />
                                            <!-- 折叠箭头 -->
                                            <TextBlock Grid.Column="1" FontSize="9" Width="10"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#x25BE;" />
                                                        <Style.Triggers>
                                                            <!-- 折叠时换成向右的箭头 -->
                                                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                                <Setter Property="Text" Value="&#x25B8;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- 版本号 -->
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- 文件数 -->
                                            <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Grid>
                                    </Button>

                                    <!-- 普通版本项 -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Kind}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource Label}" FontSize="10.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Loader, Mode=OneWay}" />
                                                <Run Text="{Binding Date, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>