<UserControl x:Class="HHCL.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="下载" Style="{StaticResource H1}" />
                <TextBlock Text="安装原版 Minecraft，装好后可以继续加 Fabric / Forge 模组加载器。" Style="{StaticResource Sub}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <ComboBox x:Name="SourceBox" Style="{StaticResource FluentComboBox}" Width="178" Height="32"
                          SelectionChanged="SourceBox_SelectionChanged">
                    <ComboBoxItem Content="BMCLAPI 镜像" Tag="bmclapi" />
                    <ComboBoxItem Content="Mojang 官方" Tag="mojang" />
                </ComboBox>
                <Button Content="重新获取" Style="{StaticResource SubtleButton}" Height="32" Margin="8,0,0,0" Click="Reload_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <!-- 版本列表 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}" Height="32" Tag="搜索版本号…"
                                 TextChanged="SearchBox_TextChanged" />
                        <CheckBox x:Name="SnapshotCheck" Grid.Column="1" Style="{StaticResource FluentSwitch}" Content="显示快照"
                                  VerticalAlignment="Center" Margin="14,0,4,0"
                                  Checked="Snapshot_Changed" Unchecked="Snapshot_Changed" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="RemoteList" Style="{StaticResource FluentListBox}" SelectionChanged="RemoteList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding SubLine}" Style="{StaticResource Label}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="ListState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ListStateText" Text="正在获取版本列表…" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 详情 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="版本详情" Style="{StaticResource Label}" />
                        <TextBlock x:Name="DetailName" Text="未选择版本" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock x:Name="DetailType" Text="—" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock x:Name="DetailDate" Text="—" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />
                        <TextBlock Text="安装选项" Style="{StaticResource Label}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="加载器" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="LoaderBox" Style="{StaticResource FluentComboBox}" Height="32"
                                          SelectedIndex="0" SelectionChanged="LoaderBox_SelectionChanged">
                                    <ComboBoxItem Content="原版" Tag="vanilla" />
                                    <ComboBoxItem Content="Fabric" Tag="fabric" />
                                    <ComboBoxItem Content="Forge" Tag="forge" />
                                    <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="加载器版本" Style="{StaticResource Label}" Margin="0,0,0,6" />
                                <ComboBox x:Name="LoaderVerBox" Style="{StaticResource FluentComboBox}" Height="32"
                                          DisplayMemberPath="Display" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LoaderHint" Text="" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Border Style="{StaticResource Divider}" Margin="0,14,0,0" />
                        <TextBlock x:Name="DetailBody" Text="从列表里选一个版本，装好之后可以直接点启动。"
                                   Style="{StaticResource Body}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,16,0,0">
                        <ProgressBar x:Name="Bar" Style="{StaticResource FluentProgress}" Height="6" Value="0" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="ProgStage" Text="" Style="{StaticResource Label}" />
                            <TextBlock x:Name="ProgRight" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                        <Button x:Name="InstallBtn" Style="{StaticResource AccentButton}" Height="34" FontSize="13" Content="下载并安装" Click="Install_Click" />
                        <Button x:Name="CancelBtn" Style="{StaticResource GhostButton}" Height="32" Content="取消下载"
                                Margin="0,8,0,0" Visibility="Collapsed" Click="Cancel_Click" />
                        <TextBlock x:Name="InstallHint" Text="" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
