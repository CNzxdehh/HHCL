<UserControl x:Class="HHCL.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="版本管理" Style="{StaticResource H1}" />
                <TextBlock x:Name="SubText" Text="本地已安装的游戏版本。" Style="{StaticResource Sub}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="打开游戏目录" Style="{StaticResource SubtleButton}" Click="OpenGameDir_Click" Height="32" />
                <Button Content="刷新" Style="{StaticResource SubtleButton}" Click="Refresh_Click" Height="32" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,16,0,12" Padding="14,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="PathText" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="CountText" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="VersionList" Style="{StaticResource FluentListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,12" Background="{DynamicResource CardBrush}" CornerRadius="8" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AccentIconBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubLine}" Style="{StaticResource Label}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="启动" Style="{StaticResource AccentButton}" Height="30" Padding="16,0"
                                            Tag="{Binding}" Click="LaunchOne_Click" />
                                    <Button Content="打开目录" Style="{StaticResource SubtleButton}" Height="30" Margin="8,0,0,0"
                                            Tag="{Binding}" Click="OpenOne_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Text="还没有任何版本。到「下载」页安装一个原版，或用第三方启动器导入整合包。"
                       Style="{StaticResource Body}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
