<UserControl x:Class="HHCL.Views.LanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="联机" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="局域网联机：不需要任何服务器。主机在游戏里「开放到局域网」，朋友用直连地址进来即可（同一个 WiFi / 局域网）。" />
        </StackPanel>

        <!-- 分段：开房间 / 加入房间 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <RadioButton x:Name="TabHost" Style="{StaticResource SegmentItem}" GroupName="LanTab" Content="开房间（主机）"
                         MinWidth="150" IsChecked="True" Checked="Tab_Checked" />
            <RadioButton x:Name="TabJoin" Style="{StaticResource SegmentItem}" GroupName="LanTab" Content="加入房间（朋友）"
                         MinWidth="170" Margin="24,0,0,0" Checked="Tab_Checked" />
        </StackPanel>

        <!-- ============ 主机 ============ -->
        <Border Grid.Row="2" x:Name="HostPanel" Style="{StaticResource Card}" Padding="18,16" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="开一个房间" Style="{StaticResource H2}" FontSize="15" />
                <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="选一个版本启动游戏，进世界后按 Esc →「开放到局域网」，启动器会自动读出房间码和地址。" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏版本" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="VersionBox" Style="{StaticResource FluentComboBox}" Height="32"
                              Margin="12,0,0,0" Width="240" HorizontalAlignment="Left"
                              SelectionChanged="VersionBox_SelectionChanged" />
                    <!-- 按钮紧跟在版本下拉右边，别甩到页面最右 -->
                    <Button Grid.Column="2" x:Name="HostStartBtn" Content="启动游戏" Style="{StaticResource AccentButton}"
                            Height="32" Width="110" Margin="12,0,0,0" Click="HostStart_Click" />
                </Grid>

                <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />

                <TextBlock Text="房间信息" Style="{StaticResource H2}" FontSize="15" Margin="0,16,0,0" />
                <TextBlock x:Name="RoomStateText" Text="还没开房间。启动游戏并开放到局域网后，这里会显示房间码和地址。"
                           Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <Border x:Name="RoomBox" Visibility="Collapsed" Background="{DynamicResource AccentPanelBrush}" CornerRadius="8" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="房间码" Style="{StaticResource Label}" />
                        <TextBlock x:Name="RoomCodeText" Text="" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock Text="直连地址（朋友填这个）" Style="{StaticResource Label}" Margin="0,12,0,0" />
                        <TextBlock x:Name="RoomAddressText" Text="" FontSize="18" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="CopyCodeBtn" Content="复制房间码" Style="{StaticResource GhostButton}" Height="32" Width="120"
                                    Click="CopyCode_Click" />
                            <Button x:Name="CopyAddrBtn" Content="复制地址" Style="{StaticResource GhostButton}" Height="32" Width="120"
                                    Margin="10,0,0,0" Click="CopyAddr_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="给朋友的话" Style="{StaticResource Label}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="CopyShareBtn" Content="复制这段话" Style="{StaticResource GhostButton}"
                                    Height="28" Width="104" Click="CopyShare_Click" />
                        </Grid>
                        <TextBlock x:Name="ShareText" Text="" Style="{StaticResource Body}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ 客机 ============ -->
        <Border Grid.Row="2" x:Name="JoinPanel" Style="{StaticResource Card}" Padding="18,16" Margin="0,16,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="加入朋友的房间" Style="{StaticResource H2}" FontSize="15" />
                <TextBlock Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="填朋友给你的直连地址（形如 192.168.1.23:51234），启动后会自动连过去。" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="直连地址" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="AddrBox" Style="{StaticResource FluentTextBox}" Height="32"
                             Margin="12,0,0,0" Tag="例如 192.168.1.23:51234" />
                    <Button Grid.Column="2" x:Name="JoinBtn" Content="直连进入" Style="{StaticResource AccentButton}"
                            Height="32" Width="120" Margin="10,0,0,0" Click="Join_Click" />
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="游戏版本" Style="{StaticResource Label}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="JoinVersionBox" Style="{StaticResource FluentComboBox}" Height="32"
                              Margin="12,0,0,0" Width="260" HorizontalAlignment="Left" />
                    <Button Grid.Column="2" x:Name="PasteBtn" Content="粘贴" Style="{StaticResource GhostButton}"
                            Height="32" Width="80" Margin="10,0,0,0" Click="Paste_Click" />
                </Grid>

                <!-- 自动发现附近房间：不用手抄 IP -->
                <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="附近的房间" Style="{StaticResource H2}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="ScanStateText" Text="" Style="{StaticResource Label}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="ScanBtn" Content="搜索房间" Style="{StaticResource GhostButton}"
                            Height="30" Width="104" Click="Scan_Click" />
                </Grid>

                <ListBox x:Name="RoomList" Style="{StaticResource FluentListBox}" Margin="0,8,0,0" MaxHeight="150"
                         HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                         SelectionChanged="RoomList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Address}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Label}" FontSize="11" Margin="0,2,0,0">
                                        <Run Text="房间码" /><Run Text="{Binding Code, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1" Content="加入" Style="{StaticResource GhostButton}"
                                        Height="28" Width="72" VerticalAlignment="Center"
                                        Tag="{Binding Address}" Click="JoinRoom_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="JoinStateText" Text="填好地址点「直连进入」即可；或者点「搜索房间」自动找同一局域网里的房间。"
                           Style="{StaticResource Label}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
