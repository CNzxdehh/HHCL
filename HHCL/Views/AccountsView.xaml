<UserControl x:Class="HHCL.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="账号" Style="{StaticResource H1}" />
            <TextBlock Text="离线账号不需要联网验证，随便起个名字就能进单人存档。" Style="{StaticResource Sub}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="账号列表" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="CountText" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <ListBox x:Name="AccountList" Grid.Row="1" Style="{StaticResource FluentListBox}" SelectionChanged="AccountList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,10" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource AccentGradientBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource AccentTagBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                        VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="当前" FontSize="10.5" Foreground="{DynamicResource AccentLightBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SubLine}" Style="{StaticResource Label}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="使用" Style="{StaticResource SubtleButton}" Height="28" FontSize="12"
                                                    Padding="12,0" Tag="{Binding}" Click="Use_Click" />
                                            <Button Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Margin="4,0,0,0"
                                                    Tag="{Binding}" Click="Delete_Click" ToolTip="删除账号">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="添加离线账号" Style="{StaticResource H2}" FontSize="14" />
                        <TextBlock Text="仅支持字母、数字和下划线，最多 16 个字符。" Style="{StaticResource Label}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="NameBox" Style="{StaticResource FluentTextBox}" Height="36" Tag="游戏内名字" Margin="0,12,0,0" />
                        <Button Content="添加账号" Style="{StaticResource AccentButton}" Height="36" Margin="0,10,0,0" Click="Add_Click" />
                        <TextBlock x:Name="ErrText" Text="" Style="{StaticResource Label}" Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="微软正版账号" Style="{StaticResource H2}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Label}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"
                                   Text="用微软账号登录，可以进正版验证的服务器。点下面的按钮后会给你一个登录码，在网页里输入并确认即可。" />
                        <Button x:Name="MsLoginBtn" Content="登录微软账号" Style="{StaticResource AccentButton}" Height="36"
                                Margin="0,12,0,0" Click="MsLogin_Click" />
                        <Button x:Name="MsRefreshBtn" Content="刷新登录状态" Style="{StaticResource SubtleButton}" Height="32"
                                Margin="0,8,0,0" Click="MsRefresh_Click" />
                        <TextBlock x:Name="MsText" Text="" Style="{StaticResource Label}" Margin="0,10,0,0"
                                   TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
