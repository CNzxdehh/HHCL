<UserControl x:Class="HHCL.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="整合包" Style="{StaticResource H1}" />
                <TextBlock Text="搜 Modrinth / CurseForge 上的整合包，一键装好原版 + 加载器 + 模组 + 配置。" Style="{StaticResource Sub}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}" Height="32" Tag="搜索整合包，比如 All the Mods、Fabric 整合…"
                     KeyDown="SearchBox_KeyDown" />
            <ComboBox Grid.Column="1" x:Name="SourceBox" Style="{StaticResource FluentComboBox}" Width="118" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="SourceBox_SelectionChanged">
                <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                <ComboBoxItem Content="CurseForge" Tag="curseforge" />
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="McBox" Style="{StaticResource FluentComboBox}" Width="104" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="McBox_SelectionChanged" />
            <ComboBox Grid.Column="3" x:Name="LoaderBox" Style="{StaticResource FluentComboBox}" Width="96" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="LoaderBox_SelectionChanged">
                <ComboBoxItem Content="任意加载器" Tag="" />
                <ComboBoxItem Content="Fabric" Tag="fabric" />
                <ComboBoxItem Content="Forge" Tag="forge" />
                <ComboBoxItem Content="NeoForge" Tag="neoforge" />
            </ComboBox>
            <Button Grid.Column="4" x:Name="SearchBtn" Content="搜索" Style="{StaticResource AccentButton}" Height="32"
                    Padding="18,0" Margin="10,0,0,0" Click="Search_Click" />
        </Grid>

        <Grid Grid.Row="2">
            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="搜索结果" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResultCount" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="PackList" Style="{StaticResource FluentListBox}" SelectionChanged="PackList_SelectionChanged" ScrollViewer.ScrollChanged="PackList_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentIconBrush}" VerticalAlignment="Center">
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" Width="42" Height="42" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" Margin="0,3,0,0"
                                                           MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource Label}" />
                                                <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="StatePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="StateText" Text="输入关键词开始搜索整合包" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
