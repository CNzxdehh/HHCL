<UserControl x:Class="HHCL.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="模组与资源" Style="{StaticResource H1}" />
                <TextBlock x:Name="SubText" Text="管理当前版本里的模组和资源包，也可以从 Modrinth 在线下载。" Style="{StaticResource Sub}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource OverlaySoft2Brush}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabInstalled" Style="{StaticResource SegmentItem}" GroupName="ModTab"
                                 Content="已安装" Width="100" IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton x:Name="TabOnline" Style="{StaticResource SegmentItem}" GroupName="ModTab"
                                 Content="在线下载" Width="100" Checked="Tab_Checked" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 已安装：版本选择 + 路径 -->
        <Grid x:Name="BarInstalled" Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="VersionBox" Style="{StaticResource FluentComboBox}" Width="260" Height="32"
                      SelectionChanged="VersionBox_SelectionChanged">
                <!-- 组头（版本号）用 ComboBoxItem 直接作为项插入，禁用且不可点；
                     版本项走这个模板显示"类型 + 加载器"。 -->
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Grid.Column="1" Style="{StaticResource CardTight}" Padding="14,9" Margin="12,0,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="PathText" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="删除的文件会移到「HHCL-回收站」，不会直接消失" Style="{StaticResource Label}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- 在线下载：搜索栏 -->
        <Grid x:Name="BarOnline" Grid.Row="1" Margin="0,16,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource FluentTextBox}" Height="32" Tag="搜索模组、资源包、光影…"
                     KeyDown="SearchBox_KeyDown" />
            <ComboBox Grid.Column="1" x:Name="SourceBox" Style="{StaticResource FluentComboBox}" Width="132" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="SourceBox_SelectionChanged">
                <ComboBoxItem Content="Modrinth" Tag="modrinth" />
                <ComboBoxItem Content="CurseForge" Tag="curseforge" />
                <ComboBoxItem Content="基岩版" Tag="bedrock" />
            </ComboBox>
            <ComboBox Grid.Column="2" x:Name="TypeBox" Style="{StaticResource FluentComboBox}" Width="104" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="TypeBox_SelectionChanged">
                <ComboBoxItem Content="模组" Tag="mod" />
                <ComboBoxItem Content="资源包" Tag="resourcepack" />
                <ComboBoxItem Content="光影" Tag="shader" />
            </ComboBox>
            <ComboBox Grid.Column="3" x:Name="McBox" Style="{StaticResource FluentComboBox}" Width="104" Height="32"
                      Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="McBox_SelectionChanged" />
            <Button Grid.Column="4" x:Name="SearchBtn" Content="搜索" Style="{StaticResource AccentButton}" Height="32"
                    Padding="18,0" Margin="10,0,0,0" Click="Search_Click" />
            <Button Grid.Column="4" Content="刷新" Style="{StaticResource SubtleButton}" Height="32" Margin="10,0,0,0" Click="RefreshLocal_Click" />
        </Grid>

        <!-- ========== 已安装 ========== -->
        <Grid x:Name="PanelInstalled" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模组" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ModCount" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="打开目录" Style="{StaticResource GhostButton}" Height="26" FontSize="12"
                                HorizontalAlignment="Right" Click="OpenMods_Click" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="ModList" Style="{StaticResource FluentListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Label}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentSwitch}" Tag="{Binding}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Checked="File_Toggled" Unchecked="File_Toggled" />
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Tag="{Binding}"
                                                    Click="File_Delete" ToolTip="删除（移到回收站）">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModEmpty" Text="这个版本还没有装模组" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="资源包" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="PackCount" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="打开目录" Style="{StaticResource GhostButton}" Height="26" FontSize="12"
                                HorizontalAlignment="Right" Click="OpenPacks_Click" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListBox x:Name="PackList" Style="{StaticResource FluentListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource Label}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource FluentSwitch}" Tag="{Binding}"
                                                      IsChecked="{Binding Enabled, Mode=OneWay}" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Checked="File_Toggled" Unchecked="File_Toggled" />
                                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" Tag="{Binding}"
                                                    Click="File_Delete" ToolTip="删除（移到回收站）">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PackEmpty" Text="这个版本还没有资源包" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========== 在线下载 ========== -->
        <Grid x:Name="PanelOnline" Grid.Row="2" Visibility="Collapsed">

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="搜索结果" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock x:Name="ResultCount" Text="" Style="{StaticResource Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="FilterText" Text="" Style="{StaticResource Label}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="OnlineList" Style="{StaticResource FluentListBox}" SelectionChanged="OnlineList_SelectionChanged"
                                 ScrollViewer.ScrollChanged="OnlineList_ScrollChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,9" Background="{DynamicResource CardHoverBrush}" CornerRadius="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="8" Background="{DynamicResource AccentIconBrush}" VerticalAlignment="Center">
                                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" Width="42" Height="42" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Label}" Margin="0,3,0,0"
                                                           MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource Label}" />
                                                <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="6,2" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding TypeText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="OnlineState" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="OnlineStateText" Text="输入关键词开始搜索" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
