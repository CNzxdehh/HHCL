<Window x:Class="HHCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HHCL" Height="760" Width="1180" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource BgBrush}"
        Icon="Assets/hhcl.ico"
        UseLayoutRounding="True" SnapsToDevicePixels="True" StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource WindowBgBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ========== 标题栏 ========== -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource LogoGradientBrush}">
                        <TextBlock Text="H" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="HHCL" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource OverlaySoftBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Minecraft 启动器" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Click="BtnMin_Click" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" Click="BtnMax_Click" ToolTip="最大化">
                        <TextBlock x:Name="BtnMaxGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" Click="BtnClose_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========== 主体 ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource NavBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,1,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="导航" Style="{StaticResource Label}" Margin="20,14,0,6" FontSize="11" Opacity="0.75" />

                        <StackPanel Grid.Row="1" Margin="0,0,0,0">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE80F;"
                                         Content="启动" IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavVersions" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8F1;"
                                         Content="版本管理" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavDownload" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE896;"
                                         Content="下载" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavMods" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE71D;"
                                         Content="模组与资源" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavModpacks" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE8F1;"
                                         Content="整合包" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavLan" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE716;"
                                         Content="联机" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavAccounts" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE77B;"
                                         Content="账号" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="&#xE713;"
                                         Content="设置" Checked="Nav_Checked" />
                        </StackPanel>

                        <!-- 账号卡片 -->
                        <Border Grid.Row="2" Margin="10,0,10,12" Background="{DynamicResource OverlaySoft2Brush}" CornerRadius="6" Padding="10,9" Cursor="Hand"
                                MouseLeftButtonUp="AccountChip_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentGradientBrush}">
                                    <TextBlock x:Name="ChipInitial" Text="S" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ChipName" Text="Steve" FontSize="12.5" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ChipType" Text="离线登录" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" x:Name="PageContainer">
                    <ContentControl x:Name="PageHost" />
                </Grid>
            </Grid>

            <!-- ========== 状态栏 ========== -->
            <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource StrokeSoftBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource StatusDotBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusVersion" Text="HHCL 1.0.0" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="·" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0" />
                        <TextBlock x:Name="StatusJava" Text="Java -" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
